#!/bin/sh

# Current brightness
curr_brightness=$(cat /sys/class/backlight/*/brightness 2>/dev/null)
max_brightness=$(cat /sys/class/backlight/*/max_brightness 2>/dev/null)

if [ -z "$max_brightness" ] || [ "$max_brightness" -eq 0 ]; then
	echo "☀️ N/A"
	exit 0
fi

brightness_per=$((100 * curr_brightness / max_brightness))

# Select icon based on brightness range
if [ "$brightness_per" -gt 80 ]; then
	icon="󰃠" # High brightness (Nerd Font)
elif [ "$brightness_per" -gt 40 ]; then
	icon="󰃟" # Medium brightness
elif [ "$brightness_per" -gt 10 ]; then
	icon="󰃞" # Low brightness
else
	icon="󰃬" # Minimum / Dim
fi

echo "$icon ${brightness_per}%"
