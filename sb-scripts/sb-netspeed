#!/bin/sh

# Detect active default network interface
IFACE=$(ip route | awk '/default/ {print $5}' | head -n 1)

if [ -z "$IFACE" ] || [ ! -d "/sys/class/net/$IFACE" ]; then
    echo "↑ ----|↓ ----"
    exit 0
fi

CACHE_FILE="/tmp/netspeed_$IFACE"

rx_now=$(cat "/sys/class/net/$IFACE/statistics/rx_bytes" 2>/dev/null)
tx_now=$(cat "/sys/class/net/$IFACE/statistics/tx_bytes" 2>/dev/null)

# Formats KB/s into a fixed 4-character string (e.g., "  0K", " 12K", "500K", "  5M")
format_speed() {
    kb=$1
    if [ "$kb" -ge 1024000 ]; then
        gb=$((kb / 1024000))
        printf "%3dG" "$gb"
    elif [ "$kb" -ge 1024 ]; then
        mb=$((kb / 1024))
        printf "%3dM" "$mb"
    else
        printf "%3dK" "$kb"
    fi
}

if [ -f "$CACHE_FILE" ]; then
    read -r rx_old tx_old <"$CACHE_FILE"

    rx_bytes=$((rx_now - rx_old))
    tx_bytes=$((tx_now - tx_old))

    # Convert bytes to KB/s
    rx_kb=$((rx_bytes / 1024))
    tx_kb=$((tx_bytes / 1024))

    down_str=$(format_speed "$rx_kb")
    up_str=$(format_speed "$tx_kb")

    echo "[↑ $up_str|↓ $down_str]"
else
    echo "[↑ ...|↓ ...]"
fi

# Save current readings for next update interval
echo "$rx_now $tx_now" >"$CACHE_FILE"
