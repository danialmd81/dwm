#!/bin/sh

# Usage: notify-bright up | down

case "$1" in
up)
    brillo -A 5 >/dev/null 2>&1
    ;;
down)
    brillo -U 5 >/dev/null 2>&1
    ;;
esac

## Signal dwmblocks to update status bar immediately (adjust signal number if needed)
# pkill -RTMIN+11 dwmblocks 2>/dev/null

# Get current brightness percentage as an integer
bright_num=$(brillo -G 2>/dev/null | awk -F'[.%]' '{print $1}')

# Send single-line notification
notify-send -h string:x-dunst-stack-tag:brightness \
    -h int:value:"$bright_num" \
    -t 1000 "Brightness: ${bright_num}%" ""
