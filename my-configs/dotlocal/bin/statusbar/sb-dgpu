#!/bin/sh

SIGNAL=10
STATE_FILE="/tmp/dwmblocks_dgpu_mode"
CLICK_BUTTON="${BUTTON:-$BLOCK_BUTTON}"
GPU_PCI="0000:01:00.0"
PWR_FILE="/sys/bus/pci/devices/$GPU_PCI/power/runtime_status"

# 0. Check if driver module exists
if [ ! -d "/sys/module/nvidia" ]; then
    [ -n "$CLICK_BUTTON" ] && notify-send "GPU Status" "Intel iGPU Active (NVIDIA driver unloaded)."
    exit 0
fi

# 1. Read sysfs directly (safe, zero bus wake)
PWR_STATE=$(cat "$PWR_FILE" 2>/dev/null || echo "unknown")

# Helper to spawn process monitor
spawn_monitor() {
    if command -v nvtop >/dev/null 2>&1; then
        setsid -f kitty -e nvtop >/dev/null 2>&1
    elif command -v btop >/dev/null 2>&1; then
        setsid -f kitty -e btop >/dev/null 2>&1
    fi
}

# 2. Handle button clicks
case "$CLICK_BUTTON" in
1) # Cycle metrics mode
    CURRENT_MODE=$(cat "$STATE_FILE" 2>/dev/null || echo "usage")
    case "$CURRENT_MODE" in
    "usage") echo "temp" >"$STATE_FILE" ;;
    "temp") echo "vram" >"$STATE_FILE" ;;
    *) echo "usage" >"$STATE_FILE" ;;
    esac
    ;;
2) # Open monitor
    spawn_monitor
    ;;
3) # Status notification
    if [ "$PWR_STATE" != "active" ]; then
        notify-send "GPU Status" "NVIDIA dGPU is in D3cold (0W Suspended)."
    else
        hogs=$(nvidia-smi --query-compute-apps=process_name,used_memory --format=csv,noheader 2>/dev/null | awk -F',' '{printf "%-20s %s\n", $1, $2}')
        [ -z "$hogs" ] && hogs="No active compute processes"
        notify-send "Top GPU Processes" "<font family='monospace'>$hogs</font>"
    fi
    ;;
esac

icon="🎮"

# 3. CRUCIAL GATE: If not active, print OFF and stop immediately
if [ "$PWR_STATE" != "active" ]; then
    echo "$icon OFF"
    exit 0
fi

# 4. Only execute nvidia-smi if something else already woke the card
MODE=$(cat "$STATE_FILE" 2>/dev/null || echo "usage")

case "$MODE" in
"temp")
    temp=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null)
    [ -n "$temp" ] && echo "$icon:${temp}°C" || echo "$icon ON"
    ;;
"vram")
    vram=$(nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null)
    if [ -n "$vram" ]; then
        echo "$vram" | awk -F',' -v ic="$icon" '{printf "%s:%.1f/%.1fGiB\n", ic, $1/1024, $2/1024}'
    else
        echo "$icon ON"
    fi
    ;;
*)
    usage=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null)
    [ -n "$usage" ] && echo "$icon:${usage}%" || echo "$icon ON"
    ;;
esac
