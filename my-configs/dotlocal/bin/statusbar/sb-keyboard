#!/bin/sh

export PATH="/usr/local/bin:/usr/bin:/bin:$HOME/.local/bin:$PATH"

CLICK_BUTTON="${BUTTON:-$BLOCK_BUTTON}"

case "$CLICK_BUTTON" in
1)
    # Left-click: toggle layout (monitor-kbd-layout handles the notify/signal)
    if command -v xkb-switch >/dev/null 2>&1; then
        xkb-switch -n
    fi
    ;;
2 | 3)
    # Middle/Right click: display layout details
    if command -v setxkbmap >/dev/null 2>&1; then
        info=$(setxkbmap -query | awk '/layout|variant|options/ {printf "%s: %s\n", $1, $2}')
        notify-send -t 1500 "Keyboard Layout" "$info"
    fi
    ;;
esac

# ------------------------------------------------------------------------------
# Always output current layout to stdout
# ------------------------------------------------------------------------------
if command -v xkb-switch >/dev/null 2>&1; then
    layout=$(xkb-switch -p 2>/dev/null)
else
    layout=$(setxkbmap -query 2>/dev/null | awk '/layout/ {print $2}' | cut -d',' -f1)
fi

case "$layout" in
us*) label="US" ;;
ir*) label="IR" ;;
*) label=$(echo "$layout" | cut -c1-2 | tr '[:lower:]' '[:upper:]') ;;
esac

echo "$label"
