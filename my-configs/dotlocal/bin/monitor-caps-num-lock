#!/bin/sh

# Prevent multiple instances
pgrep -x -f "$0" | grep -v $$ && exit 1

LAST_CAPS=""
LAST_NUM=""

# State file location
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
STATE_FILE="$STATE_DIR/numlock_state"
mkdir -p "$STATE_DIR"

while true; do
    # Query X11 keyboard status
    XSET_OUT=$(xset q)

    CAPS=$(echo "$XSET_OUT" | awk '/Caps Lock:/ {print $4}')
    NUM=$(echo "$XSET_OUT" | awk '/Num Lock:/ {print $8}')

    # Check Caps Lock change (skip initial loop run)
    if [ -n "$LAST_CAPS" ] && [ "$CAPS" != "$LAST_CAPS" ]; then
        if [ "$CAPS" = "on" ]; then
            notify-send -h string:x-canonical-private-synchronous:caps -u low -t 1000 "Caps Lock" "ON"
        else
            notify-send -h string:x-canonical-private-synchronous:caps -u low -t 1000 "Caps Lock" "OFF"
        fi
    fi

    # Check Num Lock change and persist state
    if [ "$NUM" != "$LAST_NUM" ]; then
        # Save state to file
        echo "$NUM" >"$STATE_FILE"

        # Skip notification on initial script startup
        if [ -n "$LAST_NUM" ]; then
            if [ "$NUM" = "on" ]; then
                notify-send -h string:x-canonical-private-synchronous:num -u low -t 1000 "Num Lock" "ON"
            else
                notify-send -h string:x-canonical-private-synchronous:num -u low -t 1000 "Num Lock" "OFF"
            fi
        fi
    fi

    LAST_CAPS="$CAPS"
    LAST_NUM="$NUM"

    sleep 0.2
done
