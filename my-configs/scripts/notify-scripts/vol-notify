#!/bin/sh

# Usage: vol-notify up | down | mute

case "$1" in
up)
    # Cap max volume at 100% (-l 1.0)
    wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
    ;;
down)
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
    ;;
mute)
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    ;;
esac

# Signal both dwmblocks for immediate bar updates
pkill -RTMIN+10 dwmblocks 2>/dev/null

# Get volume percentage and mute status
vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
vol_num=$(echo "$vol" | awk '{print int($2 * 100)}')

if echo "$vol" | grep -q "MUTED"; then
    notify-send -h string:x-dunst-stack-tag:volume \
        -h int:value:0 \
        -t 1000 "Volume: Muted" ""
else
    notify-send -h string:x-dunst-stack-tag:volume \
        -h int:value:"$vol_num" \
        -t 1000 "Volume: ${vol_num}%" ""
fi
