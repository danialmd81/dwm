#!/bin/sh

SIGNAL=10
STATE_FILE="/tmp/dwmblocks_dgpu_mode"
CLICK_BUTTON="${BUTTON:-$BLOCK_BUTTON}"

# 0. Check if NVIDIA driver module is loaded
if [ ! -d "/sys/module/nvidia" ]; then
    # In Integrated Mode: Output empty string so dwmblocks hides the block
    if [ "$CLICK_BUTTON" = "1" ] || [ "$CLICK_BUTTON" = "3" ]; then
        notify-send "GPU Status" "Intel iGPU Active (NVIDIA driver unloaded)."
    fi
    exit 0
fi

# 1. Check if NVML / nvidia-smi is working properly.
# If NVML initialization fails, echo nothing and exit so dwmblocks hides the block.
if ! nvidia-smi >/dev/null 2>&1; then
    if [ "$CLICK_BUTTON" = "1" ] || [ "$CLICK_BUTTON" = "3" ]; then
        notify-send "GPU Status" "NVIDIA GPU unavailable or NVML failed to initialize."
    fi
    exit 0
fi

# Helper function to spawn nvtop in kitty
spawn_monitor() {
    if command -v nvtop >/dev/null 2>&1; then
        setsid -f kitty -e nvtop >/dev/null 2>&1
    elif command -v btop >/dev/null 2>&1; then
        setsid -f kitty -e btop >/dev/null 2>&1
    elif command -v htop >/dev/null 2>&1; then
        setsid -f kitty -e htop >/dev/null 2>&1
    fi
}

case "$CLICK_BUTTON" in
1) # Left click: Cycle in-place modes
    CURRENT_MODE=$(cat "$STATE_FILE" 2>/dev/null || echo "usage")
    case "$CURRENT_MODE" in
    "usage") echo "temp" >"$STATE_FILE" ;;
    "temp") echo "vram" >"$STATE_FILE" ;;
    *) echo "usage" >"$STATE_FILE" ;;
    esac
    pkill -RTMIN+"$SIGNAL" dwmblocks
    ;;
2) # Middle click: Launch process monitor in Kitty
    spawn_monitor
    ;;
3) # Right click: Notification of top GPU processes
    if command -v nvidia-smi >/dev/null 2>&1; then
        hogs=$(nvidia-smi --query-compute-apps=process_name,used_memory --format=csv,noheader 2>/dev/null | awk -F',' '{printf "%-20s %s\n", $1, $2}')
        [ -z "$hogs" ] && hogs="No active GPU processes"
    else
        hogs="NVIDIA driver unavailable"
    fi
    notify-send "Top GPU Processes" "<font family='monospace'>$hogs</font>"
    ;;
esac

# Handle CLI toggle argument
if [ "$1" = "toggle" ]; then
    CURRENT_MODE=$(cat "$STATE_FILE" 2>/dev/null || echo "usage")
    case "$CURRENT_MODE" in
    "usage") echo "temp" >"$STATE_FILE" ;;
    "temp") echo "vram" >"$STATE_FILE" ;;
    *) echo "usage" >"$STATE_FILE" ;;
    esac
    pkill -RTMIN+"$SIGNAL" dwmblocks
fi

MODE=$(cat "$STATE_FILE" 2>/dev/null || echo "usage")

# ------------------------------------------------------------------------------
# Data Collection & Output
# ------------------------------------------------------------------------------

get_gpu_pwr_state() {
    pwr_file=$(readlink -f /sys/module/nvidia/drivers/pci:nvidia/* 2>/dev/null | head -n 1)/power/runtime_status

    if [ -f "$pwr_file" ]; then
        cat "$pwr_file"
    else
        pwr_file=$(find /sys/bus/pci/devices/ -name "runtime_status" 2>/dev/null | grep -m1 "0000:")
        [ -f "$pwr_file" ] && cat "$pwr_file" || echo "unknown"
    fi
}

get_gpu_usage() {
    usage=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null)
    [ -n "$usage" ] && echo "${usage}%" || exit 1
}

get_gpu_temp() {
    temp=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null)
    [ -n "$temp" ] && echo "${temp}°C" || exit 1
}

get_gpu_vram() {
    vram=$(nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null)
    if [ -n "$vram" ]; then
        echo "$vram" | awk -F',' '{printf "%.1f/%.1fGiB\n", $1/1024, $2/1024}'
    else
        exit 1
    fi
}

icon="🎮"

# Check if GPU is sleeping/suspended (Hybrid Mode D3cold)
PWR_STATE=$(get_gpu_pwr_state)
if [ "$PWR_STATE" = "suspended" ]; then
    echo "[$icon OFF]"
    exit 0
fi

# Render active GPU stats when dGPU is awake
case "$MODE" in
"temp")
    val=$(get_gpu_temp) || exit 0
    echo "[$icon $val]"
    ;;
"vram")
    val=$(get_gpu_vram) || exit 0
    echo "[$icon $val]"
    ;;
*)
    val=$(get_gpu_usage) || exit 0
    echo "[$icon $val]"
    ;;
esac
