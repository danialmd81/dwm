CompileFlags:
  Add:
    # Standard & Warnings
    - -std=c99
    - -pedantic
    - -Wall
    - -Wno-unused-function
    - -Wno-deprecated-declarations

    # Macro definitions
    - -DVERSION="6.8"
    - -D_DEFAULT_SOURCE
    - -D_BSD_SOURCE
    - -D_XOPEN_SOURCE=700L
    - -DXINERAMA

    # Include paths
    - -I/usr/X11R6/include
    - -I/usr/include/X11
    - -I/usr/include/freetype2
    - -I/usr/include/fribidi

    # Fix: Preload dwm.c when editing header files
    - -include
    - dwm.c
