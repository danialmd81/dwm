#!/bin/sh

# Toggle layout using xkb-switch or fallback to setxkbmap
if command -v xkb-switch >/dev/null 2>&1; then
    xkb-switch -n
else
    current=$(setxkbmap -query | awk '/layout/ {print $2}' | cut -d',' -f1)
    if [ "$current" = "us" ]; then
        setxkbmap -layout "ir,us"
    else
        setxkbmap -layout "us,ir"
    fi
fi

# Signal dwmblocks to update status bar immediately
pkill -RTMIN+9 dwmblocks 2>/dev/null

# Get new current layout
if command -v xkb-switch >/dev/null 2>&1; then
    layout=$(xkb-switch -p)
else
    layout=$(setxkbmap -query | awk '/layout/ {print $2}' | cut -d',' -f1)
fi

label=$(echo "$layout" | tr '[:lower:]' '[:upper:]')

# Send single-line notification using stack-tag to prevent overlap
notify-send -h string:x-dunst-stack-tag:keyboard \
            -t 1000 "Keyboard: ${label}" ""